{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(mypy*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(mvn test*)",
      "Bash(mvn compile*)",
      "Bash(npx playwright test*)",
      "Bash(docker compose*)",
      "Bash(docker ps*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(npx -y drawio-mcp*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "env": {
    "NODE_ENV": "development",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "mcpServers": {
    "drawio": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "NODE_OPTIONS='--no-experimental-global-navigator' npx -y drawio-mcp"],
      "env": {
        "NODE_OPTIONS": "--no-experimental-global-navigator",
        "PATH": "/usr/local/share/nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {
        "PATH": "/usr/local/share/nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
