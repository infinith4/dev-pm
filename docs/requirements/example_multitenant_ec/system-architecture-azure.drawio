        <mxCell id="entra-id" value="Microsoft Entra ID&lt;br&gt;(Per-Tenant SSO)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/identity/Azure_Active_Directory.svg;" vertex="1" parent="1">
