        <mxCell id="sftp" value="SFTP (Factory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;fontColor=#FFFFFF;strokeColor=#37474F;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="838" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="factory-webhook" value="Factory Webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;fontColor=#FFFFFF;strokeColor=#37474F;fontSize=11;fontStyle=1;" vertex="1" parent="1">
