        <mxCell id="ciam" value="External Identities&lt;br&gt;(CIAM)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/identity/External_Identities.svg;" vertex="1" parent="1">
          <mxGeometry x="1100" y="320" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ===== Security Group (right column) ===== -->
        <mxCell id="grp-security" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=12;verticalAlign=top;dashed=0;arcSize=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="470" width="260" height="110" as="geometry" />
