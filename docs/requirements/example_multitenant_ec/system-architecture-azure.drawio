        <mxCell id="user-admin" value="Tenant Admin" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=12;image=img/lib/azure2/general/User.svg;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="40" height="40" as="geometry" />
