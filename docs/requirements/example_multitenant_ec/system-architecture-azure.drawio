        <!-- ===== Monitoring Group (right column) ===== -->
        <mxCell id="grp-monitor" value="Monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;fontStyle=1;fontSize=12;verticalAlign=top;dashed=0;arcSize=8;strokeWidth=2;" vertex="1" parent="1">
