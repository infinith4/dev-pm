        <mxCell id="stripe" value="Stripe&lt;br&gt;(Payment / Billing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#635BFF;fontColor=#FFFFFF;strokeColor=#4B45C6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="838" width="140" height="45" as="geometry" />
