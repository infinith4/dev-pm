        <mxCell id="pg-platform" value="PostgreSQL&lt;br&gt;(Platform)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1">
          <mxGeometry x="350" y="660" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="blob" value="Blob Storage&lt;br&gt;(Per-Tenant)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
          <mxGeometry x="570" y="660" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ===== External Systems Group ===== -->
        <mxCell id="grp-external" value="External Systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9C27B0;fontStyle=1;fontSize=12;verticalAlign=top;dashed=0;arcSize=8;strokeWidth=2;" vertex="1" parent="1">
