          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Row 1→2: Front Door → Apps (fan out, 3 separate exit points) === -->
        <mxCell id="e-fd-ec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4CAF50;strokeWidth=1.5;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontdoor" target="react-ec">
          <mxGeometry relative="1" as="geometry" />
