        <mxCell id="e-fd-admin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4CAF50;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontdoor" target="react-admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-fd-api" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4CAF50;strokeWidth=1.5;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontdoor" target="fastapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Row 2 horizontal: EC → FastAPI, Admin → FastAPI === -->
        <mxCell id="e-ec-api" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="react-ec" target="fastapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-admin-api" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="react-admin" target="fastapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Row 2→3: FastAPI → Cache (exits bottom-left) === -->
        <mxCell id="e-api-redis" value="Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E91E63;fontSize=10;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fastapi" target="redis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="440" />
              <mxPoint x="144" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-api-search" value="Search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E91E63;fontSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fastapi" target="search">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="502" y="450" />
              <mxPoint x="334" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→3: FastAPI → Order Queue (exits bottom-right) === -->
        <mxCell id="e-api-queue" value="Enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673AB7;strokeWidth=2;fontSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fastapi" target="order-queue">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="526" y="460" />
              <mxPoint x="564" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 3→2: Order Queue → Batch Worker (upward poll) === -->
        <mxCell id="e-queue-batch" value="Poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673AB7;strokeWidth=2;fontSize=10;exitX=1;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="order-queue" target="batch-worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="460" />
              <mxPoint x="814" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→3: Batch Worker → Factory Queue (straight down) === -->
        <mxCell id="e-batch-fq" value="Transfer Job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#673AB7;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="batch-worker" target="factory-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Row 2→4: FastAPI → PG Tenant (via left edge, avoids cache row) === -->
        <mxCell id="e-api-pgT" value="Tenant Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=10;exitX=0;exitY=0.5;" edge="1" parent="1" source="fastapi" target="pg-tenant">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="80" y="364" />
              <mxPoint x="80" y="684" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→4: FastAPI → PG Platform (via left-ish route) === -->
        <mxCell id="e-api-pgP" value="Platform" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fastapi" target="pg-platform">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="502" y="430" />
              <mxPoint x="440" y="430" />
              <mxPoint x="440" y="620" />
              <mxPoint x="374" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→4: Batch → PG Tenant (via right edge, avoids queue row) === -->
        <mxCell id="e-batch-pgT" value="Extract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=10;exitX=0;exitY=0.5;" edge="1" parent="1" source="batch-worker" target="pg-tenant">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="364" />
              <mxPoint x="770" y="600" />
              <mxPoint x="154" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→4: Batch → Blob (straight-ish down via right side) === -->
        <mxCell id="e-batch-blob" value="CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=10;exitX=1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="batch-worker" target="blob">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="430" />
              <mxPoint x="860" y="620" />
              <mxPoint x="618" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→right: FastAPI → Entra ID (horizontal right) === -->
        <mxCell id="e-api-entra" value="Admin SSO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="fastapi" target="entra-id">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="340" />
              <mxPoint x="960" y="224" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→right: FastAPI → CIAM (horizontal right) === -->
        <mxCell id="e-api-ciam" value="Consumer Auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fastapi" target="ciam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="364" />
              <mxPoint x="970" y="344" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→5: FastAPI → Stripe (via far-left edge) === -->
        <mxCell id="e-api-stripe" value="Authorize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#635BFF;strokeWidth=1.5;fontSize=10;exitX=0;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="fastapi" target="stripe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="420" />
              <mxPoint x="40" y="420" />
              <mxPoint x="40" y="838" />
              <mxPoint x="100" y="838" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- === Row 2→5: Batch → Stripe (via far-left edge, offset) === -->
        <mxCell id="e-batch-stripe" value="Capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#635BFF;strokeWidth=1.5;fontSize=10;exitX=0;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="batch-worker" target="stripe">
