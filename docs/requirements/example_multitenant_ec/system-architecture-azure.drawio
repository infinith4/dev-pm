          <mxGeometry x="60" y="630" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pg-tenant" value="PostgreSQL Flex&lt;br&gt;(Per-Tenant)" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;" vertex="1" parent="1">
