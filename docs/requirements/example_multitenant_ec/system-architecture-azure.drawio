        <mxCell id="monitor" value="Azure Monitor" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/management_governance/Monitor.svg;" vertex="1" parent="1">
          <mxGeometry x="1060" y="660" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="appinsights" value="App Insights" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/devops/Application_Insights.svg;" vertex="1" parent="1">
          <mxGeometry x="1190" y="660" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ===== DR ===== -->
        <mxCell id="dr-region" value="DR: Japan West" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/general/Globe.svg;" vertex="1" parent="1">
          <mxGeometry x="1100" y="830" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- ===== EDGES (non-overlapping routes) ===== -->
        <!-- ========================================== -->

        <!-- === Row 0→1: Users → Front Door === -->
        <mxCell id="e-user-fd" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="user-consumer" target="frontdoor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-admin-fd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="user-admin" target="frontdoor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: FD ─ WAF ─ DDoS (horizontal, no arrow) -->
        <mxCell id="e-fd-waf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeColor=#0078D4;endArrow=none;startArrow=none;" edge="1" parent="1" source="frontdoor" target="waf">
