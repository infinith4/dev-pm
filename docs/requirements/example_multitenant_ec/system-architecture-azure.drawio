        <mxCell id="factory-blob" value="Factory Blob" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=11;image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1">
          <mxGeometry x="770" y="835" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- ===== Identity Group (right column) ===== -->
        <mxCell id="grp-identity" value="Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontStyle=1;fontSize=12;verticalAlign=top;dashed=0;arcSize=8;strokeWidth=2;" vertex="1" parent="1">
